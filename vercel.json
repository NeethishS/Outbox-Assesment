{
  "version": 2,
  "installCommand": "cd reachinbox/frontend && npm install",
  "buildCommand": "cd reachinbox/frontend && npm run build",
  "outputDirectory": "reachinbox/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
